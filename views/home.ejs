<div class="container my-5">
  <div class="text-center mb-5">
    <h1 class="display-4">Welcome to Budget Planner</h1>
    <p class="lead">Follow these steps to manage your finances effectively.</p>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h5 class="card-title">Step 1: Login / Signup</h5>
          <p class="card-text">Access your account securely using the navbar options.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h5 class="card-title">Step 2: Dashboard</h5>
          <p class="card-text">View your personalized dashboard with budgets and transactions.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h5 class="card-title">Step 3: Budgets</h5>
          <p class="card-text">Create and manage budgets for different categories.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h5 class="card-title">Step 4: Transactions</h5>
          <p class="card-text">Add income and expense transactions to track your spending.</p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h5 class="card-title">Step 5: Summary</h5>
          <p class="card-text">See your total income, expenses, and remaining budget at a glance.</p>
        </div>
      </div>
    </div>
  </div>

  <footer class="text-center mt-5">
    <p class="text-muted">&copy; 2026 Budget Planner App</p>
  </footer>
</div>
